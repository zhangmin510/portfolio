{
  "name": "terminal-portfolio",
  "private": true,
  "version": "1.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run sync:navigation && node scripts/clean-build.mjs && npm run build:eval-quest && node scripts/sync-panoramas.mjs && tsc && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:eval-quest": "node sites/eval-quest/build.mjs",
    "build:sites": "npm run build && node scripts/prepare-sites-build.mjs",
    "sync:panoramas": "node scripts/sync-panoramas.mjs",
    "test": "vitest run",
    "check": "npm run test && npm run build",
    "preview": "vite preview",
    "preview:cloudflare": "npm run build && wrangler dev --ip 0.0.0.0",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "sync:navigation": "node scripts/navigation/sync-sites.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
