{
  "name": "programmer-life",
  "main": "./worker/feedback.mjs",
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/feedback"]
  },
  "ratelimits": [{
    "name": "FEEDBACK_RATE_LIMITER",
    "namespace_id": "35814872",
    "simple": { "limit": 3, "period": 60 }
  }],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "programmer-life.zhangmin.name", "custom_domain": true }
  ]
}
