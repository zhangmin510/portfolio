{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "evaltube",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    { "pattern": "evaltube.zhangmin.name", "custom_domain": true }
  ]
}
