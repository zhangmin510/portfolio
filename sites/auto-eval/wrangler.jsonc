{
  "$schema":"./node_modules/wrangler/config-schema.json",
  "name":"autoeval",
  "main":"cloud/worker.mjs",
  "compatibility_date":"2026-11-06",
  "compatibility_flags":["nodejs_compat"],
  "workers_dev":false,
  "preview_urls":false,
  "assets":{"directory":"./cloud-dist","binding":"ASSETS","run_worker_first":true,"not_found_handling":"404-page"},
  "observability":{"enabled":true},
  "routes":[{"pattern":"autoeval.zhangmin.name","custom_domain":true}]
}
