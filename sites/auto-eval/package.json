{
  "name": "auto-eval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node build.mjs",
    "build:cloudflare": "node cloud/build.mjs",
    "dev:cloudflare": "npm run build:cloudflare && wrangler dev --ip 127.0.0.1 --port 8784",
    "deploy:dry": "npm run build:cloudflare && wrangler deploy --dry-run",
    "deploy": "npm run build:cloudflare && wrangler deploy",
    "types:cloudflare": "wrangler types"
  },
  "devDependencies": {
    "@noble/hashes": "^2.4.0",
    "esbuild": "^0.28.2",
    "wrangler": "^4.158.0"
  }
}
