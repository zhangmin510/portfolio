{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zhengce-radar",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
