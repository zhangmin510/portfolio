{
  "name": "ai-time-capsule",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "import": "node scripts/import.mjs",
    "check-sources": "node scripts/check-sources.mjs",
    "build:cloudflare": "node scripts/build-cloud.mjs",
    "preview:cloudflare": "npm run build:cloudflare && wrangler dev --port 8783",
    "deploy:dry": "npm run build:cloudflare && wrangler deploy --dry-run",
    "deploy": "npm run build:cloudflare && wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "wrangler": "^4.158.0"
  }
}
