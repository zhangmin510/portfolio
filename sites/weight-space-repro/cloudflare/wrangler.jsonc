{
  "name": "qwen-weight-explorer",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-11-11",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/weight-bytes", "/api/tensor.bin", "/download"]
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "routes": [{ "pattern": "weights.zhangmin.name", "custom_domain": true }]
}
